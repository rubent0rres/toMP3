{
  "name": "tomp3",
  "productName": "toMP3",
  "version": "0.1.8",
  "description": "Descarga videos de YouTube como MP4 o MP3 desde tu escritorio.",
  "author": "Yoots Software",
  "private": true,
  "repository": "https://github.com/rubent0rres/toMP3.git",
  "main": "electron/main.cjs",
  "scripts": {
    "tools:setup": "node scripts/setup-tools.mjs",
    "dev": "node scripts/dev.mjs",
    "dev:web": "next dev --hostname 127.0.0.1 --port 3210",
    "build": "next build",
    "start": "electron .",
    "check": "tsc --noEmit && eslint .",
    "test": "node --test tests/*.test.cjs",
    "pack": "npm run tools:setup && npm run build && electron-builder --dir",
    "dist": "npm run tools:setup && npm run build && electron-builder",
    "test:e2e": "npm run tools:setup && npm run build && node scripts/smoke-electron.mjs",
    "test:package": "node scripts/verify-package.mjs"
  },
  "devDependencies": {
    "@ffprobe-installer/ffprobe": "^2.1.2",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "electron": "44.7.2",
    "electron-builder": "^26.0.12",
    "eslint": "^9.0.0",
    "eslint-config-next": "16.4.0",
    "ffmpeg-static": "^5.3.0",
    "playwright": "^1.64.0",
    "typescript": "^5.9.0",
    "lucide-react": "^0.577.0",
    "next": "16.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "build": {
    "appId": "software.yoots.tomp3",
    "productName": "toMP3",
    "directories": {
      "output": "release"
    },
    "files": [
      "electron/**/*",
      "out/**/*",
      "package.json",
      "shared/**/*"
    ],
    "extraResources": [
      {
        "from": "resources/bin",
        "to": "bin"
      }
    ],
    "mac": {
      "artifactName": "toMP3-macos-${arch}.${ext}",
      "category": "public.app-category.utilities",
      "target": [
        "dmg",
        "zip"
      ],
      "identity": null
    },
    "win": {
      "artifactName": "toMP3-windows-${arch}.${ext}",
      "target": [
        "nsis"
      ]
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Utility"
    },
    "icon": "resources/icon.png"
  }
}
